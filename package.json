{
  "name": "sls-zoom-workflow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "serverless offline start",
    "deploy": "serverless deploy",
    "deploy:prod": "serverless deploy --stage prod",
    "remove": "serverless remove",
    "logs:ingress": "serverless logs -f ingress -t",
    "logs:processor": "serverless logs -f processor -t",
    "invoke:ingress": "serverless invoke local -f ingress",
    "invoke:processor": "serverless invoke local -f processor",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.700.0",
    "@supabase/supabase-js": "^2.91.1",
    "libphonenumber-js": "^1.11.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "serverless": "^4.0.0",
    "serverless-offline": "^14.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
